# Salin file ini menjadi `.env` lalu isi nilainya.
#
# `.env` TIDAK di-commit (lihat .gitignore). File ini hanya contoh, jadi tidak
# boleh memuat password sungguhan.

# --- MySQL ------------------------------------------------------------------
# Default di bawah cocok untuk instalasi lokal Laragon/XAMPP.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=helixa_olympiad

# --- API --------------------------------------------------------------------
PORT=4000

# --- Admin ------------------------------------------------------------------
# Password untuk masuk ke panel #admin. WAJIB diganti sebelum dipakai
# sungguhan: nilai defaultnya ada di dalam kode dan terbaca siapa pun.
ADMIN_PASSWORD=helixa2026

# Kunci penanda tangan token. Kalau kosong, ADMIN_PASSWORD dipakai sebagai
# gantinya - cukup untuk lokal, tapi untuk produksi isi nilai acak sendiri:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Umur token login (jam).
ADMIN_TOKEN_HOURS=12

# --- Situs ------------------------------------------------------------------
# Diisi HANYA saat situs dan API tidak berada di origin yang sama.
# Kosongkan untuk pengembangan lokal: Vite sudah mem-proxy /api ke PORT di atas.
# VITE_API_URL=https://api.example.com
