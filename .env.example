# Salin file ini menjadi `.env` lalu isi nilainya.
#
# `.env` TIDAK di-commit (lihat .gitignore). File ini hanya contoh, jadi tidak
# boleh memuat password sungguhan.

# --- MySQL ------------------------------------------------------------------
# Default di bawah cocok untuk instalasi lokal Laragon/XAMPP.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=helixa_olympiad

# --- API --------------------------------------------------------------------
PORT=4000

# --- Admin ------------------------------------------------------------------
# Hash password admin (scrypt). Buat dengan:
#   npm run admin:hash -- "password-panjang-anda"
# lalu tempel hasilnya di sini. JANGAN isi password asli di file ini.
ADMIN_PASSWORD_HASH=

# Kunci penanda tangan token. WAJIB acak di produksi:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kalau kosong, kunci acak dibuat tiap server start (admin logout saat restart).
ADMIN_SECRET=

# Umur token login (jam).
ADMIN_TOKEN_HOURS=12

# Hanya untuk dev lokal/skrip uji; dipakai kalau ADMIN_PASSWORD_HASH kosong.
# Jangan dipakai di produksi.
# ADMIN_PASSWORD=

# --- CORS & proxy (produksi) ------------------------------------------------
# Origin situs yang boleh memanggil API, pisahkan dengan koma. Kalau kosong,
# hanya localhost:5173/4173. Contoh GitHub Pages:
# ALLOWED_ORIGINS=https://skyus-code.github.io
# Isi 1 bila API berada di belakang proxy hosting (Railway/Render/Nginx).
# TRUST_PROXY=1

# --- Situs ------------------------------------------------------------------
# Alamat API untuk BUILD produksi (bukan rahasia). Di GitHub Actions diisi
# lewat Repository variable bernama API_URL. Kosongkan untuk lokal: Vite
# mem-proxy /api ke PORT di atas.
# VITE_API_URL=https://api.example.com
