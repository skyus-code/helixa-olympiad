    "check:verify": "node scripts/verify.mjs",
    "check:webgl-off": "node scripts/verify-webgl-off.mjs",
    "check:lighthouse": "node scripts/lighthouse.mjs",
    "check": "npm run build && npm run check:responsive && npm run check:verify && npm run check:webgl-off"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "gsap": "^3.15.0",
    "motion": "^13.4.6",
